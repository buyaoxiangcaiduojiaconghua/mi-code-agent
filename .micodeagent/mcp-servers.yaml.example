# MCP Server 配置示例
#
# 项目级放 <root>/.micodeagent.yaml；用户级放 ~/.micodeagent/config.yaml。
# 同名 server 项目级完整覆盖用户级。
# env / headers 的值支持 ${VAR} 从宿主环境变量展开；command/args 不展开。

mcp_servers:
  # stdio 类型：本地子进程走标准输入输出管道
  github:
    type: stdio
    command: npx
    args: ["-y", "@modelcontextprotocol/server-github"]
    env:
      GITHUB_TOKEN: "${GITHUB_TOKEN}"

  local-sqlite:
    type: stdio
    command: python
    args: ["-m", "mcp_server_sqlite", "--db", "./data.db"]

  # http 类型：远程走 Streamable HTTP
  example-http:
    type: http
    url: "https://mcp.example.com/mcp"
    headers:
      Authorization: "Bearer ${EXAMPLE_TOKEN}"
